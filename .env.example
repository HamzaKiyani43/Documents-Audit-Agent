# Copy this file to .env and fill in ONE provider's key and model.

# Groq
GROQ_API_KEY=
CHAT_MODEL=groq:openai/gpt-oss-20b

# Anthropic
# ANTHROPIC_API_KEY=
# CHAT_MODEL=anthropic:claude-sonnet-5-5

# Google
# GOOGLE_API_KEY=
# CHAT_MODEL=google_genai:gemini-2.5-flash

# OpenAI
# OPENAI_API_KEY=
# CHAT_MODEL=openai:gpt-4o-mini

# Optional settings (defaults shown)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHROMA_DIR=chroma_db
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=4
# MAX_SEARCHES=2
# MAX_CONCURRENCY=4
# STRUCTURED_OUTPUT=